{
  "name": "primecad-overlay",
  "version": "0.10.4",
  "description": "ERA ER:LC server manager and fixed phone overlay",
  "main": "src/main.js",
  "author": "ERA",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "test": "node --test tests/*.test.js",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "xyz.primecad.overlay",
    "productName": "ERA",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/era.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ERA"
    },
    "artifactName": "ERA-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "taylorsigma20-cmd",
        "repo": "era",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@paymoapp/active-window": "^2.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorsigma20-cmd/era.git"
  }
}
